  "interviewFramework": {
    "_source": "《终极面试问答》琳恩·威廉斯",
    "threeBasicQuestions": {
      "title": "面试官三大基本问题",
      "description": "所有面试问题本质上都是这三个问题的变式",
      "questions": [
        {
          "key": "can_do",
          "question": "你能做好这份工作吗？",
          "focus": "经验、技能、能力",
          "commonVariants": ["你目前的工作有哪些职责？", "你有什么做这份工作的经验？", "你为什么觉得你能够胜任这份工作？", "你的优势是什么？", "你能够为这份工作带来什么？"]
        },
        {
          "key": "will_do",
          "question": "你愿意做好这份工作吗？",
          "focus": "热情、动力、职业道德",
          "commonVariants": ["你为什么觉得这份工作适合你？", "在工作中，你的抗压能力如何？", "你的长期职业规划是什么？", "你如何看待挑战？", "你最大的成就是什么？", "你的工作动力源于哪里？"]
        },
        {
          "key": "fit_in",
          "question": "你能融入我们公司吗？",
          "focus": "文化认同、团队合作、价值观",
          "commonVariants": ["你能不能和其他人愉快地共事？", "你觉得一名好的团队成员应该是怎么样的？", "你对我们公司了解多少？", "面对别人的批评，你会如何反应？", "你的同事是如何评价你的？"]
        }
      ]
    },
    "sixKeyTraits": {
      "title": "面试官最看重的六大特质",
      "description": "90%的雇主认为这些特质与学历同等重要或更重要",
      "traits": [
        { "key": "wisdom", "name": "智慧", "indicators": ["好奇心", "常识", "行动力", "分析能力", "学习能力"] },
        { "key": "affinity", "name": "亲和力", "indicators": ["平易近人", "善于合作", "善于交际", "沟通能力", "团队精神"] },
        { "key": "talent", "name": "才能", "indicators": ["责任心", "积极主动", "可靠", "专业水准", "高质量交付"] },
        { "key": "integrity", "name": "正直", "indicators": ["诚实", "可靠", "言行一致", "谨慎", "自我意识"] },
        { "key": "optimism", "name": "乐观", "indicators": ["活力", "主动性", "自信", "积极向上", "坚持不懈"] },
        { "key": "adaptability", "name": "适应能力", "indicators": ["灵活", "学习意愿", "抗压能力", "沉着冷静", "解决问题"] }
      ]
    },
    "answerPrinciples": {
      "title": "回答问题三原则",
      "principles": [
        "紧扣要点，回答控制在两分钟内",
        "用真实的事例回答，而非假设",
        "不要闲谈，回答完问题后停止说话"
      ]
    }
  },

